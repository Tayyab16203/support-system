# =============================================================================
# SUPPORT SYSTEM BACKEND - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# App
APP_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (Supabase)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id

# AWS S3
S3_BUCKET_NAME=support-system-uploads

# AWS SES
SES_FROM_EMAIL=support@yourdomain.com

# AWS CloudWatch
CLOUDWATCH_LOG_GROUP=/support-system/api
CLOUDWATCH_LOG_STREAM=development

# Jira Integration (optional - leave empty to disable)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=bot@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# Discord (configured per project in DB, no global env needed)
